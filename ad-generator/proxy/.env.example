# Copy to .env (never commit .env) and fill in.

# Required: server-side Anthropic key the proxy uses to reach Fable 5 / Opus.
# Use the "API Ad generator Claude" key from the Wellshave vault.
ANTHROPIC_API_KEY=

# Optional: shared secret callers must send as `Authorization: Bearer <key>`
# or `x-api-key: <key>`. Leave empty for local dev; SET IT for any public deploy.
PROXY_API_KEY=

# Optional model overrides (defaults shown).
PRIMARY_MODEL=claude-fable-5
FALLBACK_MODEL=claude-opus-4-8

# Optional: allow callers to pick a different claude-* model instead of forcing primary.
ALLOW_MODEL_OVERRIDE=false

# Optional tuning.
DEFAULT_MAX_TOKENS=4096
CORS_ORIGIN=*
PORT=8787

# Optional: point at a gateway instead of api.anthropic.com (e.g. Cloudflare AI Gateway).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
