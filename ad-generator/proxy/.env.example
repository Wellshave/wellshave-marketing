# Copy to .env (never commit .env) and fill in.

# Required: server-side Anthropic key the proxy injects on every call.
# Accepts ANTHROPIC_API_KEY or ANTHROPIC_KEY.
# MUST have Fable 5 access AND the org must have >= 30 days data retention
# (Fable 5 does not run under zero-data-retention).
ANTHROPIC_API_KEY=

# CORS origin. "*" works; lock down to the app origin for a public deploy:
# CORS_ORIGIN=https://wellshave-adgen.netlify.app
CORS_ORIGIN=*

# Only used when a caller omits these headers (the app always sends them).
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BETA=server-side-fallback-2026-06-01

PORT=8787

# Optional: point at a mock or gateway instead of the real API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
